# Example settings for the container (docker-compose.yml). Copy to .env.docker and fill in.
# NEVER commit .env.docker: it holds secrets. In production the infrastructure team gives these
# values to the container its own way (secrets manager, orchestrator...): same names.

# ----- The app -----
# False in production. A long random secret (python -c "import secrets; print(secrets.token_urlsafe(60))")
SECRET_KEY=put-a-long-random-value-here
# The address(es) people type, separated by commas
ALLOWED_HOSTS=localhost,127.0.0.1
# True when people reach the app through https:// (behind the company's reverse proxy / load balancer)
HTTPS=False
HSTS_SECONDS=3600
# Full public address, used for the links inside emails
SITE_URL=http://localhost:8000
# Time to trust the reverse proxy's "this visitor used https" header: its address, or * if the
# container network is private. See DEPLOY-DOCKER.md.
TRUSTED_PROXY=127.0.0.1

# ----- Database (PostgreSQL 16 or newer) -----
DB_NAME=itpm
DB_USER=itpm_user
DB_PASSWORD=put-the-database-password-here
DB_HOST=db
DB_PORT=5432

# ----- Email -----
# Trial: emails are only printed in the container's log.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=IT Projects <it-projects@example.com>
# Production: Microsoft 365 (steps for the tenant administrator: EMAIL-M365-SETUP.md). Use:
#   EMAIL_BACKEND=config.graph_email.GraphEmailBackend
# and fill these four (the secret goes through your secret store, not git):
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=
