msgid "Changes saved."
msgstr "تم حفظ التغييرات."

#: administration/views.py
msgid "You can't deactivate your own account. Another admin can."
msgstr "لا يمكنك تعطيل حسابك بنفسك. يمكن لمسؤول آخر فعل ذلك."

#: administration/views.py
msgid "This account is deactivated already."
msgstr "هذا الحساب معطّل بالفعل."

#: administration/views.py
#, python-format
msgid "The account of %(person)s is deactivated: they can't log in anymore. Their projects, tasks and comments are kept."
msgstr "تم تعطيل حساب %(person)s: لم يعد بإمكانه تسجيل الدخول. تبقى مشاريعه ومهامه وتعليقاته محفوظة."

