#, python-format
msgid "The account of %(person)s is active again: they can log in."
msgstr "عاد حساب %(person)s نشطًا: يمكنه تسجيل الدخول."

#: administration/views.py
#, python-format
msgid "%(person)s is now in the team of %(project)s."
msgstr "أصبح %(person)s ضمن فريق %(project)s."

#: administration/views.py
#, python-format
msgid "%(person)s manages %(project)s, and the manager is always in the team. To take them out, first choose another manager on the project's Edit page."
msgstr "%(person)s يدير %(project)s، ومدير المشروع ضمن الفريق دائمًا. لإخراجه، اختر أولًا مديرًا آخر في صفحة تعديل المشروع."

#: administration/views.py
#, python-format
msgid "%(person)s still has %(count)d open task in %(project)s. Give it to someone else (or finish it) first."
msgid_plural "%(person)s still has %(count)d open tasks in %(project)s. Give them to someone else (or finish them) first."
msgstr[0] "لا يزال لدى %(person)s %(count)d مهمة مفتوحة في %(project)s. أسندها إلى شخص آخر (أو أنهِها) أولًا."
msgstr[1] "لا يزال لدى %(person)s مهمة مفتوحة واحدة في %(project)s. أسندها إلى شخص آخر (أو أنهِها) أولًا."
msgstr[2] "لا يزال لدى %(person)s مهمتان مفتوحتان في %(project)s. أسندهما إلى شخص آخر (أو أنهِهما) أولًا."
msgstr[3] "لا يزال لدى %(person)s %(count)d مهام مفتوحة في %(project)s. أسندها إلى شخص آخر (أو أنهِها) أولًا."
msgstr[4] "لا يزال لدى %(person)s %(count)d مهمة مفتوحة في %(project)s. أسندها إلى شخص آخر (أو أنهِها) أولًا."
msgstr[5] "لا يزال لدى %(person)s %(count)d مهمة مفتوحة في %(project)s. أسندها إلى شخص آخر (أو أنهِها) أولًا."

#: administration/views.py
#, python-format
msgid "%(person)s is no longer in the team of %(project)s."
msgstr "لم يعد %(person)s ضمن فريق %(project)s."

#: administration/views.py
msgid "This login couldn't be found."
msgstr "تعذّر العثور على عملية تسجيل الدخول هذه."

#: administration/views.py
#, python-format
msgid "The login with the username %(username)s is unlocked."
msgstr "تم فتح قفل تسجيل الدخول لاسم المستخدم %(username)s."

#: administration/views.py
msgid "There was nothing to unlock: these wrong passwords don't count anymore."
msgstr "لم يكن هناك ما يلزم فتحه: لم تعد كلمات المرور الخاطئة هذه محتسبة."

