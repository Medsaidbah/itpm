msgid "Choose a project…"
msgstr "Choisissez un projet…"

#: administration/forms.py
msgid "This account is deactivated. Reactivate it before adding the person to a project."
msgstr "Ce compte est désactivé. Réactivez-le avant d'ajouter la personne à un projet."

#: administration/views.py
msgid "Only admins can open the Administration section."
msgstr "Seuls les administrateurs peuvent ouvrir la section Administration."

#: administration/views.py
#, python-format
msgid "The account of %(person)s is created. Give them their username and first password in person or by phone, not by email. They can change the password on their profile."
msgstr "Le compte de %(person)s est créé. Donnez-lui son nom d'utilisateur et son premier mot de passe en main propre ou par téléphone, pas par e-mail. La personne peut changer son mot de passe dans son profil."

#: administration/views.py projects/views.py
msgid "Changes saved."
msgstr "Modifications enregistrées."

#: administration/views.py
#, python-format
msgid "The new password of %(person)s is saved. Give it to them in person or by phone, not by email. They can change it on their profile."
msgstr "Le nouveau mot de passe de %(person)s est enregistré. Donnez-le en main propre ou par téléphone, pas par e-mail. La personne peut le changer dans son profil."

#: administration/views.py
msgid "You can't deactivate your own account. Another admin can."
msgstr "Vous ne pouvez pas désactiver votre propre compte. Un autre administrateur peut le faire."

#: administration/views.py
msgid "This account is deactivated already."
msgstr "Ce compte est déjà désactivé."

#: administration/views.py
#, python-format
msgid "The account of %(person)s is deactivated: they can't log in anymore. Their projects, tasks and comments are kept."
msgstr "Le compte de %(person)s est désactivé : la personne ne peut plus se connecter. Ses projets, tâches et commentaires sont conservés."

#: administration/views.py
#, python-format
msgid "The account of %(person)s is active again: they can log in."
msgstr "Le compte de %(person)s est de nouveau actif : la personne peut se connecter."

#: administration/views.py
#, python-format
msgid "%(person)s is now in the team of %(project)s."
msgstr "%(person)s fait maintenant partie de l'équipe de %(project)s."

#: administration/views.py
#, python-format
msgid "%(person)s manages %(project)s, and the manager is always in the team. To take them out, first choose another manager on the project's Edit page."
msgstr "%(person)s gère %(project)s, et le chef de projet fait toujours partie de l'équipe. Pour le retirer, choisissez d'abord un autre chef de projet sur la page Modifier du projet."

#: administration/views.py
#, python-format
msgid "%(person)s still has %(count)d open task in %(project)s. Give it to someone else (or finish it) first."
msgid_plural "%(person)s still has %(count)d open tasks in %(project)s. Give them to someone else (or finish them) first."
msgstr[0] "%(person)s a encore %(count)d tâche ouverte dans %(project)s. Donnez-la à quelqu'un d'autre (ou terminez-la) d'abord."
msgstr[1] "%(person)s a encore %(count)d tâches ouvertes dans %(project)s. Donnez-les à quelqu'un d'autre (ou terminez-les) d'abord."

#: administration/views.py
#, python-format
msgid "%(person)s is no longer in the team of %(project)s."
msgstr "%(person)s ne fait plus partie de l'équipe de %(project)s."

#: administration/views.py
msgid "This login couldn't be found."
msgstr "Cette connexion est introuvable."

#: administration/views.py
#, python-format
msgid "The login with the username %(username)s is unlocked."
msgstr "La connexion avec le nom d'utilisateur %(username)s est déverrouillée."

#: administration/views.py
msgid "There was nothing to unlock: these wrong passwords don't count anymore."
msgstr "Il n'y avait rien à déverrouiller : ces mots de passe erronés ne comptent plus."

