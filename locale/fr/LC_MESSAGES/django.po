msgstr "Nom d'utilisateur"

#: administration/forms.py templates/administration/user_list.html
msgid "Role"
msgstr "Rôle"

#: administration/forms.py
msgid "What they type to log in. Letters, digits and @ . + - _ only."
msgstr "Ce que la personne saisit pour se connecter. Lettres, chiffres et @ . + - _ uniquement."

#: administration/forms.py
msgid "Admins see and change everything, including this Administration section. Users see the projects they manage or whose team they are in."
msgstr "Les administrateurs voient et modifient tout, y compris cette section Administration. Les utilisateurs voient les projets qu'ils gèrent ou dont ils font partie de l'équipe."

