# Example of the .env file: every value the app reads from .env.
# Copy it to .env and put your own values. Never commit .env: it holds passwords.
# Lines starting with # are comments.

# ----- Development (your PC) or production (the server) -----
# True on your PC while developing. False on the server: errors show a simple page, not the code.
DEBUG=True
# A long random secret, different on each computer. Make one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=put-a-long-random-value-here

# ----- Database (PostgreSQL) -----
DB_NAME=itpm
DB_USER=itpm_user
DB_PASSWORD=put-the-database-password-here
DB_HOST=localhost
DB_PORT=5432

# ----- The app's address -----
# What people type to open the app. Several? Separate them with commas.
ALLOWED_HOSTS=127.0.0.1,localhost
# True on the server, where people use https://
HTTPS=False
# How long browsers must remember to use only https (in seconds).
# Start with 3600 (1 hour); once everything works, use 31536000 (1 year).
HSTS_SECONDS=3600
# The full address, for the links inside emails (on the server: https://your-address)
SITE_URL=http://127.0.0.1:8000

# ----- Email -----
# While developing, emails are printed in the terminal:
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=IT Projects <it-projects@example.com>

# To send real emails through Microsoft 365 (see EMAIL-M365-SETUP.md), use these instead of the console line above:
# EMAIL_BACKEND=config.graph_email.GraphEmailBackend
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=put-the-secret-in-the-server-only
# GRAPH_SENDER=it-projects@company.mr
